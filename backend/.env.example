# ── LLM ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_tu-key-aquí

# ── Email (Gmail SMTP) ────────────────────────────────────
# Usa una "App Password" de Google, no tu contraseña normal
# Actívala en: myaccount.google.com → Seguridad → Contraseñas de aplicación
EMAIL_SENDER=tu-email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Vector Store ──────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# ── App ───────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,null
SIMILARITY_THRESHOLD=0.1

# ── Agent ─────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=8
AGENT_TIMEOUT=60
